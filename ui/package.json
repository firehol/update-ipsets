{
  "name": "update-ipsets-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:budget": "pnpm build && pnpm bundle-budget",
    "bundle-budget": "node scripts/check-bundle-budget.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-experimental-webstorage\" vitest run",
    "pretest:e2e": "pnpm build",
    "test:e2e": "NO_COLOR= playwright test --project=chromium",
    "pretest:e2e:configured": "pnpm build",
    "test:e2e:configured": "NO_COLOR= playwright test",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-experimental-webstorage\" vitest",
    "test:bundle-budget": "node --test scripts/check-bundle-budget.test.mjs",
    "test:coverage": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-experimental-webstorage\" vitest run --coverage"
  },
